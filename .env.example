# 火山引擎豆包 TTS
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_CLUSTER=volcano_tts
VOLC_VOICE_TYPE=BV700_V2_streaming

# twitterapi.io
TWITTERAPI_KEY=

# 订阅的 X 用户名（不带 @，逗号分隔）
SUBSCRIPTIONS=TaoRay,dontbesilent,karpathy,naval

# 是否包含回复推文（1=包含，其他=不包含）
INCLUDE_REPLIES=0

# 抓取周期（分钟）
FETCH_INTERVAL_MINUTES=60

# 服务端口
PORT=3000
